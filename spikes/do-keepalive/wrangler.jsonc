// Spike C: hibernating Durable Object WebSocket (docs/spikes.md).
// No account_id here (ADR 0007): wrangler uses the logged-in account.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warpshot-spike-keepalive",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "KEEPALIVE", "class_name": "KeepaliveHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["KeepaliveHub"] }]
}

<resources>
    <string name="app_name" translatable="false">Warpshot</string>
    <string name="share_label">Send to PC</string>

    <!-- Onboarding and pairing. The PC side's labels ("Pairing", "Show pairing
         code", "Pair with PC") must match apps/windows-ui/src/i18n.ts. -->
    <string name="onb_tagline">Screenshots, text and files between your phone and your PC, instantly.</string>
    <string name="onb_steps_title">Pair with your PC</string>
    <string name="onb_step1">On your PC, click the Warpshot icon in the taskbar, open Pairing and press “Show pairing code”.</string>
    <string name="onb_step2">Tap “Pair with PC” below and scan the code.</string>
    <string name="onb_step3">Check that both screens show the same code, then confirm.</string>
    <string name="onb_privacy">No account needed. Everything is end-to-end encrypted: only your own devices can read what you send.</string>
    <string name="pair_with_pc">Pair with PC</string>
    <string name="try_again">Try again</string>
    <string name="pair_not_code">This is not a Warpshot pairing code.</string>

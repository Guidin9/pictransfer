    <string name="pairing_wait">Keep Warpshot open on both devices.</string>
    <string name="paired_with">Paired with %1$s.</string>
    <string name="pairing_failed">Pairing failed. %1$s</string>
    <string name="pair_err_invalid">This code is invalid or has expired. Show a new code on your PC and scan again.</string>
    <string name="pair_err_rejected">Pairing was cancelled or the code expired. Show a new code on your PC and try again.</string>
    <string name="pair_err_network">Couldn\'t reach your PC. Make sure both devices are online, then try again with a new code.</string>
    <string name="scanner_unavailable">Scanner unavailable: %1$s</string>
